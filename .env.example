# 복사해서 .env로 사용하세요. .env는 커밋되지 않습니다.
# GitHub Actions에서는 같은 이름의 Repository Secrets로 주입합니다.

# --- 공공데이터포털 (data.go.kr) ---
# 선거공약정보 / 당선인정보 API 인증키 (Decoding 키). 약관상 제3자 공유 금지.
DATA_GO_KR_SERVICE_KEY=

# --- Supabase ---
SUPABASE_URL=https://<project-ref>.supabase.co
# 공개 읽기 전용 키 (sb_publishable_... 또는 구 anon 키, RLS 적용). 유휴 방지 핑·웹 프론트에서 사용
SUPABASE_PUBLISHABLE_KEY=
# 파이프라인 적재용 Postgres 접속 문자열 (Supavisor pooler, IPv4). 절대 프론트에 노출 금지
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# --- LLM (4주차 베이크오프 후 확정) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- 알림 (크롤러·배치 실패) ---
DISCORD_WEBHOOK_URL=
